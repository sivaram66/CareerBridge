# ─────────────────────────────────────────────────────────────
# CareerBridge Backend — Environment Variables
# Copy this to .env for local dev. Set these in Render dashboard for prod.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000           # Render: https://careerbridge-api.onrender.com

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-prod

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# AI (Google Gemini)
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# Job Search (SerpAPI — for Google Jobs internship sweep)
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend URL for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173      # Render: https://careerbridge.vercel.app
