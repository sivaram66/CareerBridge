# ─────────────────────────────────────────────────────────────
# CareerBridge Frontend — Environment Variables
# Set VITE_BACKEND_URL in Vercel dashboard → Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Local development — points to local backend
VITE_BACKEND_URL=http://localhost:5000/api

# Production — set this in Vercel dashboard to your Render backend URL:
# VITE_BACKEND_URL=https://careerbridge-api.onrender.com/api
